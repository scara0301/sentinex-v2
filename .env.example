DATABASE_URL=postgresql+asyncpg://sentinex:sentinex@localhost:5432/sentinex
REDIS_URL=redis://localhost:6379/0
DOCKER_HOST=unix:///var/run/docker.sock
SECRET_KEY=change-me-in-production
SENTINEX_ENV=development
OPENAI_API_KEY=sk-sentinex-fake-key-for-dev
ANTHROPIC_API_KEY=sk-ant-sentinex-fake-key-for-dev
MOCK_STRIPE_URL=http://localhost:4010
MOCK_SLACK_URL=http://localhost:4011

